# Copy this file to .env and fill in the values.
# Never commit the actual .env file.

# HTTP port the Express server listens on
PORT=5000

# application environment
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/gopratle_requirements  (docker compose up -d)
# Production: paste your MongoDB Atlas connection string here
MONGODB_URI=mongodb://127.0.0.1:27017/gopratle_requirements

# Comma-separated list of allowed CORS origins
# Local: http://localhost:3000
# Production: your Vercel deployment URL
FRONTEND_URL=http://localhost:3000

# Rate limiting for POST /api/requirements
# Window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (generous for dev; tighten in production)
RATE_LIMIT_MAX_REQUESTS=30
